+def reclaim_ci_inputs(nsp_dir, env):
+    """Release downloaded CI copies after all game and DLC extraction succeeds."""
+    if env.get('DM_CI_RECLAIM_INPUTS') != '1':
+        return 0
+    runner_temp = env.get('RUNNER_TEMP')
+    if (env.get('GITHUB_ACTIONS') != 'true' or not runner_temp or
+            nsp_dir.resolve() != Path(runner_temp).resolve() / 'nsp'):
+        raise BuildError('CI input reclamation requires RUNNER_TEMP/nsp on a GitHub Actions runner')
+    removed = 0
+    for container in nsp_dir.iterdir():
+        if container.is_file() and container.suffix.lower() in {'.nsp', '.nsz', '.xci', '.xcz'}:
+            container.unlink()
+            removed += 1
+    say(f'CI: released {removed} input container copies after extraction; {free_gb(nsp_dir):.1f} GB free')
+    return removed
 
 
