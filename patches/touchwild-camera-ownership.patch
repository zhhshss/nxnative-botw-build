+// The checks below are written for a plain 844x390 fixture that has no device
+// safe-area insets. Hosting the fixture in a real window scene - which the
+// orientation checks need - otherwise lets the pad inherit the device insets;
+// that shifts every right-hand BOTW control left and moves the R shoulder drop
+// onto the camera probe and the virtual B face key onto the AppCamera footer.
+@interface HarnessFixtureHost : UIView
+@end
+@implementation HarnessFixtureHost
+- (UIEdgeInsets)safeAreaInsets { return UIEdgeInsetsZero; }
+@end
+
+// The orientation checks require a real UIWindowScene, including on SDK 27.
+// Start only after the scene's view has appeared, not from application launch.
+@interface HarnessRootController : UIViewController
+@property(nonatomic, strong) DmGamepad *pad;
+@property(nonatomic) BOOL testsStarted;
+@end
+@implementation HarnessRootController
+- (void)viewDidLoad {
+    [super viewDidLoad];
+    puts("Harness: root view loaded");
+    HarnessFixtureHost *host = [[HarnessFixtureHost alloc] initWithFrame:CGRectMake(0, 0, 844, 390)];
+    [self.view addSubview:host];
+    // The artwork fixture covers enabled badges; the custom-layout test checks default-off.
+    setenv("DM_BOTW_PAD_BADGES","1",1);
+    UIView *raw = dm_gamepad_view(CGRectMake(0, 0, 844, 390));
+    unsetenv("DM_BOTW_PAD_BADGES");
+    [host addSubview:raw]; [raw setFrame:CGRectMake(0, 0, 844, 390)]; [raw layoutIfNeeded];
+    self.pad = (DmGamepad *)raw;
+}
+- (void)viewDidAppear:(BOOL)animated {
+    [super viewDidAppear:animated];
+    if (self.testsStarted) return;
+    self.testsStarted = YES;
+    puts("Harness: scene view appeared; starting UIKit checks");
+    dispatch_async(dispatch_get_main_queue(), ^{ run_tests(self.pad); });
+}
+@end
+
