+static void test_look_owner_recovery(DmGamepad *view) {
+    g_look_enabled = YES; [view setFull:YES]; [view reset];
+    reset_look();
+    FakeTouch *older = touch(600,150), *newer = touch(700,180);
+    older.timeValue = 10; newer.timeValue = 11;
+    [view touchesBegan:[NSSet setWithObjects:newer, older, nil] withEvent:nil];
+    int count = g_look_count;
+    moved(view, older,610,150);
+    CHECK(g_look_count == count, "simultaneous begins choose the newest timestamp, regardless of set order");
+    moved(view, newer,710,180);
+    CHECK(g_look_count == count + 1, "the newest eligible camera finger receives movement");
+    cancelled(view,newer,710,180);
+    count = g_look_count;
+    moved(view,older,620,150);
+    CHECK(g_look_count == count && !g_look_held && g_rx == 0,
+          "cancelling a replacement never revives the displaced camera finger");
+    ended(view,older,620,150);
+
+    // Simulate a recognizer or interrupted dispatch consuming the release.
+    // The display callback must clear it even with no later touch event.
+    for (int phase = UITouchPhaseEnded; phase <= UITouchPhaseCancelled; phase++) {
+        reset_look();
+        FakeTouch *lost = touch(600,150); began(view,lost); moved(view,lost,625,165);
+        lost.phaseValue = (UITouchPhase)phase; lost.point = CGPointMake(900,300);
+        count = g_look_count;
+        [view pollLookTouches];
+        CHECK(g_look_count == count + 1 && g_look_events[count].phase == DM_LOOK_CANCEL &&
+              !g_look_held && g_rx == 0 && g_ry == 0 && g_queued_dx == 0 && g_queued_dy == 0,
+              "display polling cancels a missed End/Cancel without adding its stale final position");
+        [view pollLookTouches];
+        moved(view,lost,910,310); ended(view,lost,910,310);
+        CHECK(g_look_count == count + 1 && g_rx == 0 && g_ry == 0,
+              "a recovered camera finger stays inert on late callbacks");
+    }
+
+    reset_look();
+    FakeTouch *lost = touch(600,150); began(view,lost); moved(view,lost,620,150);
+    lost.phaseValue = UITouchPhaseCancelled;
+    CGPoint facePoint = [view facePos:0]; FakeTouch *face = touch(facePoint.x,facePoint.y);
+    began(view,face);
+    CHECK(!g_look_held && g_rx == 0 && (g_buttons & DM_BTN_A),
+          "an unrelated control begin recovers a missed look cancel and keeps its own button input");
+    ended(view,face,facePoint.x,facePoint.y);
+
+    reset_look();
+    older = touch(600,150); newer = touch(700,180);
+    began(view,older); began(view,newer); moved(view,newer,710,180);
+    older.phaseValue = UITouchPhaseEnded; count = g_look_count;
+    [view pollLookTouches];
+    CHECK(g_look_held && g_look_count == count && g_rx != 0,
+          "recovering a displaced finger's missed release leaves the current owner moving");
+    ended(view,newer,710,180);
+
+    // Layout refresh is another native display path and must also recover.
+    reset_look(); lost = touch(600,150); began(view,lost); moved(view,lost,620,150);
+    lost.phaseValue = UITouchPhaseCancelled;
+    [view setNeedsLayout]; [view layoutIfNeeded];
+    CHECK(!g_look_held && g_rx == 0 && g_ry == 0,
+          "native layout refresh clears a missed camera cancel");
+    [view reset];
 }
 
