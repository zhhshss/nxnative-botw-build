 #define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+
+// No GPU needed: the present thread samples production diagnostics while the
+// encode thread changes counters. Run separately under ThreadSanitizer.
+enum { FEEDBACK_STATS_ITERATIONS = 200000 };
+static _Atomic int feedback_stats_finished;
+static void *feedback_stats_encode(void *unused) {
+    (void)unused;
+    for (int i = 0; i < FEEDBACK_STATS_ITERATIONS; i++) {
+        g_fb_count++; g_fb_bytes += 1024; g_fb_reuse += 3;
+        g_fb_refresh[i % 5]++; g_rt_merge_n++;
+    }
+    atomic_store(&feedback_stats_finished, 1);
+    return NULL;
+}
+static int feedback_stats_sample(uint64_t *total) {
+    char line[512]; unsigned long long copies = 0;
+    mtl_feedback_stats(line, sizeof line);
+    if (sscanf(line, "copies %llu", &copies) != 1) return 0;
+    *total += copies;
+    return 1;
+}
+static int feedback_stats_check(void) {
+    NvProg *program = [NvProg new];
+    __attribute__((objc_precise_lifetime)) NvShader *shader = [NvShader new];
+    program->sh[1] = shader; shader->rf.nb = 1;
+    int kinds[] = {NVN_RB_IMG, NVN_RB_SBUFP, NVN_RB_SBUFU};
+    for (unsigned i = 0; i < sizeof kinds / sizeof kinds[0]; i++) {
+        shader->rf.b[0] = (nvn_rbind){.kind=kinds[i], .rw=1};
+        if (prog_swrites(program) != 2) {
+            fprintf(stderr, "FAIL: writable binding kind %d was not classified as a fragment write\n", kinds[i]); return 1;
+        }
+        shader->rf.b[0].rw = 0;
+        if (prog_swrites(program)) { fprintf(stderr, "FAIL: read-only binding classified as a write\n"); return 1; }
+    }
+    pthread_t worker;
+    if (pthread_create(&worker, NULL, feedback_stats_encode, NULL)) return 1;
+    uint64_t total = 0; int valid = 1;
+    do {
+        valid &= feedback_stats_sample(&total);
+    } while (!atomic_load(&feedback_stats_finished));
+    if (pthread_join(worker, NULL)) return 1;
+    valid &= feedback_stats_sample(&total);
+    if (!valid || total != FEEDBACK_STATS_ITERATIONS ||
+            atomic_load(&g_fb_bytes) != FEEDBACK_STATS_ITERATIONS * 1024ull ||
+            atomic_load(&g_fb_reuse) != FEEDBACK_STATS_ITERATIONS * 3ull ||
+            atomic_load(&g_rt_merge_n) != FEEDBACK_STATS_ITERATIONS) {
+        fprintf(stderr, "FAIL: feedback counters lost updates\n"); return 1;
+    }
+    puts("feedback diagnostic counters: PASS (concurrent encode/present, no GPU)");
+    return 0;
+}
 
